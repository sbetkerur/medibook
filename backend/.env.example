# ─────────────────────────────────────────────────────────────
# MediBook Backend — Environment Variables
# Copy this file to .env and fill in the values before starting.
# ─────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────
# Full PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/medibook

# Max connections in the pool (increase for multi-instance deployments; Railway Postgres default max is 97)
DB_POOL_MAX=20

# Statement timeout in milliseconds — protects against runaway queries.
# Keep this at 10000: bot queries should never take >10s, and a slow query
# holding a pooled connection for 30s can starve the pool under load
# (see the rationale in src/db/index.js).
DB_STATEMENT_TIMEOUT_MS=10000

# ── REDIS ─────────────────────────────────────────────────────
# If REDIS_URL is unset the app runs single-instance: BullMQ queues, distributed
# cron locks and shared rate-limit counters are all skipped (each degrades to a
# safe in-process fallback). It is NOT probed on localhost by default.
# Used for BullMQ job queues and distributed cron locking.
# BullMQ requires Redis >= 5.0. On older Redis, bot processing falls back to sync.
REDIS_URL=redis://localhost:6379

# ── AUTH ──────────────────────────────────────────────────────
# REQUIRED: Must be a random string of at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_32_char_random_string

# ── ENCRYPTION ────────────────────────────────────────────────
# REQUIRED in production: 32-character key for encrypting WhatsApp access tokens
# and bot session context (PII) stored in the database.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_generate_a_32_char_random_key

# ── META WHATSAPP CLOUD API ───────────────────────────────────
# Obtain these from: https://developers.facebook.com → Your App → WhatsApp → API Setup
META_PHONE_NUMBER_ID=PLACEHOLDER_REPLACE_WITH_PHONE_NUMBER_ID
META_ACCESS_TOKEN=PLACEHOLDER_REPLACE_WITH_ACCESS_TOKEN
META_APP_SECRET=PLACEHOLDER_REPLACE_WITH_APP_SECRET
# The human-dialable number behind META_PHONE_NUMBER_ID (that one is an opaque
# id, not a phone number). Every clinic's QR code and booking deep link is built
# from this, so without it no clinic can be reached at all and the dashboard's
# QR panel reports that it is not configured. Digits or E.164 both work.
WHATSAPP_PUBLIC_NUMBER=919999999999

# Set to any string you choose; must match what you register in the Meta console
META_WEBHOOK_VERIFY_TOKEN=PLACEHOLDER_REPLACE_WITH_VERIFY_TOKEN

# ── SERVER ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────
# REQUIRED in production: the URL of your deployed frontend.
# Multiple origins: comma-separated (e.g. https://app.example.com,https://www.example.com)
FRONTEND_URL=http://localhost:3000

# ── OBSERVABILITY (OPTIONAL) ─────────────────────────────────
# Sentry DSN for error tracking (install @sentry/node to enable)
SENTRY_DSN=

# ── TIMEZONE ─────────────────────────────────────────────────
# Used by reminder cron for time comparisons. Default: Asia/Kolkata
# Must be a valid IANA timezone string (e.g. Asia/Dubai, America/New_York)
TIMEZONE=Asia/Kolkata

# The PROCESS timezone must stay UTC. All "today in IST" logic converts from UTC
# (toZonedTime + date-fns getters, and (NOW() AT TIME ZONE 'Asia/Kolkata')::date
# in SQL); a non-UTC TZ silently shifts slot generation and date labels by a day.
# The server logs a warning at startup if TZ is set to anything else.
TZ=UTC

# ── FEATURE FLAGS ─────────────────────────────────────────────
# Set to "true" to enable the /api/webhook/test endpoint in production
# (disabled by default in production — only for debugging)
ENABLE_TEST_ENDPOINT=false

# The demo clinic ('pragati-demo' / "Pragati Dental Studio") is created by
# migrate on every boot unless DEMO_TENANT=false. It runs READ-ONLY so its
# login can be shared with anyone evaluating the product — every /api/admin
# write 403s. Set DEMO_READ_ONLY=false to hand-edit the fixture (restart, edit,
# restart with it back on); the flag is re-asserted from this value each boot.
DEMO_READ_ONLY=true
# The public "See a live demo" button (frontend /demo) calls
# POST /api/auth/demo-session, which issues a passwordless session for this slug
# — but ONLY while that tenant is read_only + active. Defaults to 'pragati-demo'.
DEMO_TENANT_SLUG=pragati-demo

# ── LOGGING ──────────────────────────────────────────────────
# Log level: error | warn | info | debug  (default: info)
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# SELF-SERVE SIGNUP  (routes/signup.js)
# A clinic can create its own account: WhatsApp OTP to verify the owner's
# number, then a 14-day CARD-FREE trial. The card is only needed to continue
# past the trial (Settings › Billing → Razorpay Checkout). A super admin still
# approves each clinic (status pending_review) before patients can reach it.
# ─────────────────────────────────────────────────────────────

# Master switch. Leave false until Razorpay + the OTP template below are set up.
SELF_SIGNUP_ENABLED=false

# Free-trial length in days (default 14).
SIGNUP_TRIAL_DAYS=14

# Days a clinic may sit in `past_due` (trial lapsed / payment failed) before the
# dunning cron suspends it (default 7). It can always log in and add a card
# during this window.
SIGNUP_DUNNING_GRACE_DAYS=7

# Clinic-initiated patient messages / rolling 24h a self-serve tenant may send
# WHILE ON THE CARD-FREE TRIAL (default 50). Lifted the moment a live Razorpay
# subscription is attached. Protects the shared number's Meta quality rating from
# a trial spam run. Reminders/confirmations are never capped. 0 = block all
# trial outreach.
SIGNUP_TRIAL_SEND_CAP=50

# WhatsApp template that delivers the 6-digit code. A clinic owner never messages
# the shared number, so they are outside Meta's 24h window and a plain text send
# is rejected in production — an approved AUTHENTICATION (or UTILITY) template is
# required. One body variable = the code. Set _HAS_BUTTON=false for a UTILITY
# template with no copy-code button.
SIGNUP_OTP_TEMPLATE=
SIGNUP_OTP_TEMPLATE_HAS_BUTTON=true

# WhatsApp template sent to the owner when a super admin APPROVES their clinic —
# a self-serve signup provisions nothing until approval, so this message (with a
# login link) is the owner's only way back in. Approved UTILITY template, two
# body variables: {{1}} = clinic name, {{2}} = login URL. In dev it falls back
# to a plain text send, so no template is needed locally.
SIGNUP_APPROVED_TEMPLATE=

# ── RAZORPAY ────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Test keys start rzp_test_, live rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. Create a webhook pointing at
# https://<backend>/api/webhook/razorpay subscribed to the subscription.*
# events, and paste its secret here.
RAZORPAY_WEBHOOK_SECRET=
# Create ONE recurring Plan per tier in the Razorpay dashboard (monthly, amount
# in paise: 79900 / 179900) and paste their plan ids here. These are also
# written to plans.razorpay_plan_id on every boot. The plan amount is
# GST-INCLUSIVE — a "₹799" plan charges ₹799 and the tax invoice back-computes
# ₹677 taxable + ₹122 GST. Professional is billed plan amount × active branches.
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PROFESSIONAL=

# ── GST TAX INVOICES ───────────────────────────────────────
# The selling entity that appears on every subscription tax invoice
# (billing_invoices, generated from the subscription.charged webhook).
# STATE_CODE is the 2-digit GST state code (29 = Karnataka) — it decides
# CGST+SGST (buyer in the same state) vs IGST (interstate).
SELLER_LEGAL_NAME=Pragati Solutions
SELLER_GSTIN=
SELLER_STATE_CODE=29
SELLER_ADDRESS=A202, Mantri Lithos, Manyata Tech Park, Bengaluru 560045
INVOICE_NUMBER_PREFIX=MB

# ── LIFECYCLE ──────────────────────────────────────────────
# Comma-separated WhatsApp numbers pinged when a self-serve clinic lands in the
# review queue (so a 2 a.m. signup isn't stuck until someone opens the
# dashboard). Leave blank to keep the queue dashboard-only.
SIGNUP_REVIEW_NOTIFY_PHONE=
# Grace window before a tenant-requested account deletion is carried out
# (schema DROPped, tenants row deleted). Cancellable any time within it.
ACCOUNT_DELETION_GRACE_DAYS=14
