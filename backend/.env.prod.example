# MediBook backend — production environment template.
#
# Copy to  backend/.env.prod  and fill in. Used by docker-compose.prod.yml
# (the DR fallback stack). NEVER commit the filled-in file — .gitignore covers
# .env.prod, but check.
#
# [VAULT]  = restore verbatim from the offline vault (scripts/dump-env.js output
#            / password manager). Getting ENCRYPTION_KEY wrong makes every backup
#            unreadable; getting JWT_SECRET wrong just logs everyone out.
# [SET]    = environment-specific, set for this host.
# [OPT]    = optional; leave blank to disable that feature.

# ─────────────────────────────────────────────────────────────────────────────
# Core — the app refuses to start in production without these
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL=                       # [SET] overridden by docker-compose.prod.yml to the compose postgres
JWT_SECRET=                         # [VAULT] >= 32 chars
ENCRYPTION_KEY=                     # [VAULT] >= 32 chars — MUST match the key the backups were taken under
FRONTEND_URL=https://app.pragatisolutions.com   # [SET] locks CORS/CSP; no trailing slash

# WhatsApp / Meta Cloud API — the only messaging channel
META_ACCESS_TOKEN=                  # [VAULT]
META_PHONE_NUMBER_ID=              # [VAULT]
META_WEBHOOK_VERIFY_TOKEN=         # [VAULT]
META_APP_SECRET=                   # [VAULT] (shared prod<->dev by design)
WHATSAPP_PUBLIC_NUMBER=            # [SET] human-dialable number behind META_PHONE_NUMBER_ID (E.164 or digits)

# ─────────────────────────────────────────────────────────────────────────────
# Infra
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=                          # [SET] overridden by docker-compose.prod.yml; without Redis everything degrades to in-process
TIMEZONE=Asia/Kolkata              # [OPT]
WEBHOOK_RATE_LIMIT_PER_MIN=2000    # [OPT] per-IP; Meta delivers from a shared pool so this is ~platform-wide
SENTRY_DSN=                         # [OPT]
METRICS_SECRET=                     # [OPT]
OPENAI_API_KEY=                     # [OPT] voice-note transcription only

# ─────────────────────────────────────────────────────────────────────────────
# Backups & disaster recovery
# ─────────────────────────────────────────────────────────────────────────────
BACKUP_DIR=/data/backups           # [SET] mount a volume here or the in-container backup is lost on restart
BACKUP_CRON=0 */6 * * *            # [OPT] default 30 2 * * * (nightly); every 6h once off-site upload is on
BACKUP_MAX_FILES=14               # [OPT] local/volume retention count (default 14)

# Off-site copy — an S3-compatible bucket on a provider UNRELATED to Railway
# (Cloudflare R2 recommended; Backblaze B2 / AWS S3 also work). Both backup
# paths (nightly cron + scripts/backup-prod.js) upload here when set.
BACKUP_S3_BUCKET=                   # [SET]
BACKUP_S3_ENDPOINT=                # [SET] e.g. https://<accountid>.r2.cloudflarestorage.com  (omit for real AWS S3)
BACKUP_S3_REGION=auto             # [SET] 'auto' for R2; the real region for S3/B2
BACKUP_S3_ACCESS_KEY_ID=          # [VAULT]
BACKUP_S3_SECRET_ACCESS_KEY=      # [VAULT]
BACKUP_S3_PREFIX=medibook-backups/ # [OPT]
BACKUP_S3_KEEP=30                 # [OPT] remote retention count
BACKUP_S3_FORCE_PATH_STYLE=true   # [OPT] true for B2/MinIO, harmless on R2

# Dead-man's-switch ping URLs (Healthchecks.io / Better Stack / Cronitor).
# Alert channel must NOT be WhatsApp — that's the channel that may be down.
HEALTHCHECK_BACKUP_URL=            # [SET] pinged by the in-container nightly backup
HEALTHCHECK_BACKUP_PROD_URL=       # [SET] pinged by scripts/backup-prod.js on the off-Railway machine

# For the off-Railway backup / restore scripts, run on a non-Railway machine:
# MEDIBOOK_BACKUP_DIR=~/MediBookBackups   MEDIBOOK_BACKUP_KEEP=14

# ─────────────────────────────────────────────────────────────────────────────
# Two-environment WhatsApp routing (PRODUCTION ONLY — never set on dev)
# ─────────────────────────────────────────────────────────────────────────────
TEST_ROUTE_URL=                    # [SET] dev's /api/webhook/whatsapp — unknown codes forward here
TEST_ENTRY_CODES=TRYMED           # [SET] codes that must always resolve to dev
DEMO_TENANT=false                 # [SET] don't recreate the demo clinic in prod
SEED_DEMO_DATA=false              # [SET]
# DISABLE_PATIENT_CRONS / WHATSAPP_ALLOWED_RECIPIENTS are DEV-only guards — leave unset in prod

# ─────────────────────────────────────────────────────────────────────────────
# Self-serve signup + billing (Razorpay)
# ─────────────────────────────────────────────────────────────────────────────
SELF_SIGNUP_ENABLED=false         # [SET] master switch
SIGNUP_TRIAL_DAYS=14              # [OPT]
SIGNUP_DUNNING_GRACE_DAYS=7       # [OPT]
SIGNUP_TRIAL_SEND_CAP=50          # [OPT]
SIGNUP_OTP_TEMPLATE=              # [SET] if signup enabled
SIGNUP_OTP_TEMPLATE_HAS_BUTTON=true
SIGNUP_APPROVED_TEMPLATE=         # [SET] if signup enabled
SIGNUP_REVIEW_NOTIFY_PHONE=       # [OPT] comma list, WhatsApp ping on new pending_review clinic
RAZORPAY_KEY_ID=                  # [VAULT]
RAZORPAY_KEY_SECRET=             # [VAULT]
RAZORPAY_WEBHOOK_SECRET=         # [VAULT]
RAZORPAY_PLAN_STARTER=           # [SET]
RAZORPAY_PLAN_PROFESSIONAL=      # [SET]

# ─────────────────────────────────────────────────────────────────────────────
# GST invoicing + account lifecycle
# ─────────────────────────────────────────────────────────────────────────────
SELLER_LEGAL_NAME=
SELLER_GSTIN=
SELLER_STATE_CODE=29              # decides CGST+SGST vs IGST (29 = Karnataka)
SELLER_ADDRESS=
INVOICE_NUMBER_PREFIX=MB
ACCOUNT_DELETION_GRACE_DAYS=14
