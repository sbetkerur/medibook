# Dependencies
node_modules/
.npm

# Environment files — NEVER commit these
.env
.env.local
.env.production
.env.prod
.env.*.local

# Backups & DR artefacts — full encrypted copies of every clinic's data, and
# plaintext secret snapshots. Belt-and-braces in case a restore/verify/dump is
# ever run from inside the repo tree.
*.dump
*.dump.enc
*.sql.enc
railway-env-snapshot-*.txt

# Build output
.next/
out/
dist/
build/

# Playwright E2E (frontend/) — browsers, reports and run artefacts
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
frontend/.playwright/

# Logs
*.log
npm-debug.log*
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Runtime
*.pid
*.seed
pids/

# Postgres portable (local only)
pg_portable/
.claude/worktrees/

# Lead lists — real business contact data, keep out of git
leads/
docs/*.xlsx

# Generated clinic QR codes (scripts/exportClinicQrCodes.js).
# Regenerate with `npm run qr:export` — these embed the live WhatsApp number
# and every clinic's entry code, so they are build artefacts, not source.
backend/qr-codes/
